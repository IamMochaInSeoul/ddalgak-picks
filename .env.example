# ══════════════════════════════════════════════════════════════════════════════
# .env.example — 실제 값은 절대 여기에 넣지 마세요
# 이 파일은 git에 올라갑니다. 실제 키는 .env (gitignore)에만 작성하세요.
# Vercel 배포 시: Dashboard → Settings → Environment Variables 에 등록
# ══════════════════════════════════════════════════════════════════════════════

# ─── Google Drive + OAuth ────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# ─── Supabase (공개 키 — ANON 권한만) ────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── PortOne V2 (공개 키) ─────────────────────────────────────────────────────
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# ─── 분석 ─────────────────────────────────────────────────────────────────────
# GA4 측정 ID (예: G-XXXXXXXXXX). 미설정 시 이벤트 전송 noop.
VITE_GA_MEASUREMENT_ID=

# ─── 광고 / 모니터링 ──────────────────────────────────────────────────────────
VITE_ADSENSE_CLIENT_ID=
VITE_SENTRY_DSN=

# ─── 기능 플래그 ──────────────────────────────────────────────────────────────
VITE_FEATURE_PAYMENT=false
# 인물 클러스터링·주인공 선택 (default ON). "false"로 박을 때만 비활성화.
VITE_FEATURE_PERSON_CLUSTERING=

# ─── 기타 ─────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_FACE_EMBEDDING_MODEL_URL=

# ══════════════════════════════════════════════════════════════════════════════
# 서버 전용 (Supabase Edge Function / CI) — 절대 VITE_ 붙이지 말 것
# ══════════════════════════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORTONE_API_SECRET=
PG_PORTONE_MODE=sandbox
ADMIN_PASSWORD_HASH=
JWT_SECRET=
